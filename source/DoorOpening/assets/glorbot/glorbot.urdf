  <!-- franka hand: the stock Panda 2-finger gripper -->
  <!-- Stock Franka flange frame: the hand mounts on panda_link8 at z=0.107 off panda_link7 and
       is then yawed -45 deg, which is where the hardware puts it. -->
  <link name="panda_link8" />
  <joint name="panda_joint8" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.107" />
    <parent link="panda_link7" />
    <child link="panda_link8" />
  </joint>

  <link name="panda_hand">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.04" />
      <mass value="0.73" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0017" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/visual/hand.obj" />
      </geometry>
      <material name="panda_white" />
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/collision/hand.obj" />
      </geometry>
      <material name="panda_white" />
    </collision>
  </link>
  <joint name="panda_hand_joint" type="fixed">
    <origin rpy="0 0 -0.7853981633974483" xyz="0 0 0" />
    <parent link="panda_link8" />
    <child link="panda_hand" />
  </joint>

  <!-- Grasp center, i.e. the stock panda_hand_tcp pose: 0.1034 m out along the hand z, level
       with the finger pads and centered between them. Named "palm_center" because that is the
       end-effector body name the rest of the codebase resolves (slider_controller,
       hard_code_traj, the env's key-body list). Its frame is yawed -45 deg about z relative to
       panda_link7, since it hangs off panda_hand. -->
  <link name="palm_center" />
  <joint name="palm_center_joint" type="fixed">
    <parent link="panda_hand" />
    <child link="palm_center" />
    <origin rpy="0 0 0" xyz="0 0 0.1034" />
  </joint>

  <link name="panda_leftfinger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.0145 0.0227" />
      <mass value="0.015" />
      <inertia ixx="0.0000023750" ixy="0" ixz="0" iyy="0.0000023750" iyz="0"
        izz="0.00000075" />
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/visual/finger.obj" />
      </geometry>
      <material name="panda_white" />
    </visual>
    <!-- Collision uses the VISUAL mesh, not meshes/franka/collision/finger.obj. That file is a
         32-face CONVEX HULL of the finger (21.98 cm^3 vs the real finger's 11.22 cm^3), and the
         finger is an L: its pad is only the last ~18 mm, while the shank is set back ~11.5 mm from
         the grasp centerline. Hulling it bridges base to tip in a straight wedge, so the collider
         came up to 10 mm closer to the centerline than any real material over z = 6..36 mm. The
         jaw was ~20 mm narrower than it looks, and a lever bar entering the jaw struck phantom
         geometry before ever reaching the pads. The spawn cfg sets collider_type of
         "convex_decomposition", which recovers the recess from this mesh to within ~2 mm. -->
    <collision>
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/visual/finger.obj" />
      </geometry>
    </collision>
  </link>
  <!-- Same mesh as the left finger, rotated 180 deg about z so its pad faces inward. -->
  <link name="panda_rightfinger">
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.0145 0.0227" />
      <mass value="0.015" />
      <inertia ixx="0.0000023750" ixy="0" ixz="0" iyy="0.0000023750" iyz="0"
        izz="0.00000075" />
    </inertial>
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/visual/finger.obj" />
      </geometry>
      <material name="panda_white" />
    </visual>
    <!-- Visual mesh as the collider, same reason as panda_leftfinger above. -->
    <collision>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0" />
      <geometry>
        <mesh filename="package://glorbot/meshes/franka/visual/finger.obj" />
      </geometry>
    </collision>
  </link>
  <!-- ONE commanded DOF, like the real hand: the Franka gripper has a single actuator and the
       two fingers are mechanically coupled, so panda_finger_joint2 mimics panda_finger_joint1
       1:1 (same as upstream franka_description). The joint value is the half-opening, so 0.04
       is fully open (8 cm between the pads) and 0.0 is closed; the opposed axes (+y / -y) make
       equal values move the fingers symmetrically.

       For the importer to honor this and emit a PhysxMimicJointAPI constraint, the spawn cfg
       must set convert_mimic_joints_to_normal_joints=True. That field is passed straight to
       the importer's set_parse_mimic(), so despite its name True means "parse the mimic tag"
       and the default False means "treat it as an ordinary independent joint". See
       glorbot_cfg.py, which sets it and explains. Controllers additionally command both joints
       to the same value, so the gripper stays single-DOF even if the constraint is not
       created. -->
  <joint name="panda_finger_joint1" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.0584" />
    <parent link="panda_hand" />
    <child link="panda_leftfinger" />
    <axis xyz="0 1 0" />
    <limit effort="70" lower="0.0" upper="0.04" velocity="0.05" />
  </joint>
  <joint name="panda_finger_joint2" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.0584" />
    <parent link="panda_hand" />
    <child link="panda_rightfinger" />
    <axis xyz="0 -1 0" />
    <limit effort="70" lower="0.0" upper="0.04" velocity="0.05" />
    <mimic joint="panda_finger_joint1" multiplier="1.0" offset="0.0" />
  </joint>

  <!-- Pad frames, used as grasp keypoints / contact probes. Placed ON the gripping face (y=0 in the finger frame; the
       finger body extends outward from there) and at z=0.045, the same height up the finger as
       the stock TCP. So the two frames sit exactly the commanded opening apart (0.08 m when
       open, 0.0 when closed) and their midpoint is palm_center. -->
  <link name="left_fingertip" />
  <joint name="left_fingertip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.045" />
    <parent link="panda_leftfinger" />
    <child link="left_fingertip" />
  </joint>
  <link name="right_fingertip" />
  <joint name="right_fingertip_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.045" />
    <parent link="panda_rightfinger" />
    <child link="right_fingertip" />
  </joint>



