<?xml version="1.0" encoding="utf-8"?>
<robot name="tidybot2">
  <material name="black">
    <color rgba="0.235 0.235 0.235 1"/>
  </material>
  <material name="lilac">
    <color rgba="0.7608 0.7059 0.8431 1"/>
  </material>
  <material name="white">
    <color rgba="1 1 1 0.9"/>
  </material>
  <material name="grey">
    <color rgba="0.8 0.8 0.8 1"/>
  </material>
  <material name="silver">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>

  <link name="base_link" />
  <!-- Prismatic joint along X (world frame) -->
  <link name="base_x_link" />
  <joint name="base_x_joint" type="prismatic">
    <parent link="base_link" />
    <child link="base_x_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-5.0" upper="5.0" effort="1000" velocity="1.0" />
  </joint>
  <!-- Prismatic joint along Y (world frame) -->
  <link name="base_y_link" />
  <joint name="base_y_joint" type="prismatic">
    <parent link="base_x_link" />
    <child link="base_y_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-5.0" upper="5.0" effort="1000" velocity="1.0" />
  </joint>
  <!-- Revolute joint for yaw -->
  <link name="base_rotation_link" />
  <joint name="base_rotation_joint" type="revolute">
    <parent link="base_y_link" />
    <child link="base_rotation_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-100000" upper="100000" effort="1000" velocity="3.14" />
  </joint>

  <!-- tidybot2 base -->
  <link
    name="tidybot2_base_link">
    <inertial>
      <origin
        xyz="-0.00084689 1.1277E-08 0.24191"
        rpy="0 0 0" />
      <mass
        value="34" /> 
      <inertia
        ixx="0.049027"
        ixy="4.572E-11"
        ixz="1.0156E-07"
        iyy="0.031404"
        iyz="1.0444E-11"
        izz="0.071516" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://glorbot/meshes/tidybot2/tidybot2_base_link.STL" />
      </geometry>
      <material name="grey">
      </material>
    </visual>
    <!-- Lidar-mast-only collision. The chassis BODY (z<0.43) is already collided by the
         front/back/left/right/top panels + franka_control_box, which also carry the contact
         penalties; the full tidybot2_base_link.STL duplicated that volume (Y up to +-0.254,
         right at the panels at +-0.2555) so it wrapped/stole the left/right panel contacts,
         and its solid mid-body sits inside the Franka/X5 workspace and snagged the arms.
         tidybot2_mast.STL is the STL cropped to just the thin lidar pole (triangles reaching
         above z=0.75): a 0.04x0.04 tube spanning z[0.595,1.595] at (x=-0.26,y=0). Exact real
         geometry, so no oversized box. NOTE: the pole's lower end (z~0.6-0.9) is within the
         Franka's back reach; if the arm ever swings behind itself it could touch it. If that
         happens, filter chassis-vs-arm collisions rather than shrinking the pole. -->
    <collision name="mast_pole">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://glorbot/meshes/tidybot2/tidybot2_mast.STL" />
      </geometry>
    </collision>
  </link>
  <!-- Final attachment of chassis to the virtual base -->
  <joint name="base_to_chassis_fixed" type="fixed">
    <parent link="base_rotation_link" />
    <child link="tidybot2_base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- lidar -->
  <link name="lidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://glorbot/meshes/tidybot2/lidar.STL" />
      </geometry>
      <material name="black">
      </material>
    </visual>
    <collision>
      <origin xyz="0.014 0 -0.011" rpy="0 0 0" />
      <geometry>
        <box size="0.103 0.075 0.148" />
      </geometry>
    </collision>
  </link>
  <!-- Fixed joint to chassis_link -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="-0.19039 0 1.5648" rpy="-3.1416 0.7854 -3.1416" />
    <parent link="tidybot2_base_link" />
    <child link="lidar" />
    <axis xyz="0 0 0" />
  </joint>

  <!-- imu -->
  <link name="imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://glorbot/meshes/tidybot2/imu.STL" />
      </geometry>
      <material name="black">
      </material>
    </visual>
  </link>
  <!-- Fixed joint to chassis_link -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="-0.195 0 0.73278" rpy="0 0 0" />
    <parent link="tidybot2_base_link" />
    <child link="imu" />
    <axis xyz="0 0 0" />
  </joint>


  <!-- franka control box -->
  <link name="franka_control_box">
      <visual>
          <origin xyz="-0.1535 0 0.48927" rpy="0 0 0" />
          <geometry>
              <box size="0.355 0.483 0.089" />
          </geometry>
          <material name="black" />
      </visual>
      <collision>
          <origin xyz="-0.1535 0 0.48927" rpy="0 0 0" />
          <geometry>
              <box size="0.355 0.483 0.089" />
